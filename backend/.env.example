# Copy to backend/.env or export in the shell. Demo defaults are safe for local use.

# Persistence: memory | sqlite | postgres
VETMIND_STORAGE=sqlite
# VETMIND_SQLITE_PATH=./data/vetmind.sqlite3
# VETMIND_DATABASE_URL=postgresql://vetmind:vetmind@localhost:5432/vetmind

# Quarantine disk root for uploaded bytes
# VETMIND_QUARANTINE_ROOT=./data/quarantine

# Async analyze artificial delay (ms, 0–10000)
VETMIND_ASYNC_DELAY_MS=400

# Jobs: thread (default) | rq
VETMIND_JOB_BACKEND=thread
# VETMIND_REDIS_URL=redis://127.0.0.1:6379/0
# VETMIND_RQ_QUEUE=vetmind

# RAG: embedding (default hash-embedding) | lexical
VETMIND_RAG=embedding
# VETMIND_RAG_INDEX_PATH=./data/rag_index.json

# Optional remote Vision HTTP adapter
# VETMIND_VISION_ENDPOINT=http://127.0.0.1:8090/infer
# VETMIND_VISION_MODEL_ID=remote-vision-v1
# VETMIND_VISION_API_KEY=

# Auth (off by default). Demo seed: vet@demo.local / demo1234
VETMIND_AUTH_ENABLED=0
# VETMIND_API_KEY=
# VETMIND_JWT_SECRET=vetmind-demo-secret-change-me
# VETMIND_JWT_TTL_SECONDS=43200
