# Copy to backend/.env or export in the shell. Demo defaults are safe for local use.
# How to plug in real Vision / LLM / KB when you have them: ../docs/INTEGRATION_PLAYBOOK.md

# Persistence: memory | sqlite | postgres
VETMIND_STORAGE=sqlite
# VETMIND_SQLITE_PATH=./data/vetmind.sqlite3
# VETMIND_DATABASE_URL=postgresql://vetmind:vetmind@localhost:5432/vetmind

# Quarantine disk root for uploaded bytes
# VETMIND_QUARANTINE_ROOT=./data/quarantine

# Async analyze artificial delay (ms, 0–10000)
VETMIND_ASYNC_DELAY_MS=400

# Jobs: thread (default) | rq
VETMIND_JOB_BACKEND=thread
# VETMIND_REDIS_URL=redis://127.0.0.1:6379/0
# VETMIND_RQ_QUEUE=vetmind

# RAG: embedding (default hash-embedding) | lexical
VETMIND_RAG=embedding
# VETMIND_RAG_INDEX_PATH=./data/rag_index.json

# --- Optional remote Vision HTTP adapter (see fixtures/integration/vision_*.example.json) ---
# VETMIND_VISION_ENDPOINT=http://127.0.0.1:8090/infer
# VETMIND_VISION_MODEL_ID=remote-vision-v1
# VETMIND_VISION_API_KEY=
# VETMIND_VISION_MODALITIES=MR,CT,XR
# VETMIND_VISION_REGIONS=BRAIN,SPINE,THORAX
# VETMIND_VISION_SPECIES=canine,feline
# VETMIND_VISION_EXECUTION_POLICY=exclusive_real
# VETMIND_VISION_TIMEOUT_S=30
# VETMIND_VISION_TRANSMIT_PIXELS=0
# Pixel decode remains default-deny unless both this flag and capability allow it:
# VETMIND_PIXEL_ANALYSIS_OPT_IN=0
# Optional LocalTorch (weights required; readiness reports blockers if missing):
# VETMIND_LOCAL_TORCH_MODEL_ID=
# VETMIND_LOCAL_TORCH_ENTRYPOINT=
# VETMIND_LOCAL_TORCH_WEIGHTS_PATH=
# VETMIND_LOCAL_TORCH_MODALITIES=MR
# VETMIND_LOCAL_TORCH_REGIONS=BRAIN

# --- LLM: mock (default) | stub | http | openai | ollama | anthropic ---
VETMIND_LLM_PROVIDER=mock
# VETMIND_LLM_ENDPOINT=http://127.0.0.1:11434/v1
# VETMIND_LLM_PROVIDER_ID=http-llm
# VETMIND_LLM_MODEL_ID=qwen2.5:14b
# VETMIND_LLM_MODEL_VERSION=0.1.0
# VETMIND_LLM_API_KEY=
# VETMIND_LLM_TIMEOUT_S=30
# VETMIND_LLM_REPORT_LANGUAGE=tr
# VETMIND_LLM_TEMPERATURE=0.2
# VETMIND_LLM_MAX_TOKENS=2048
# VETMIND_LLM_JSON_MODE=schema

# Auth (off by default). Demo seed: vet@demo.local / demo1234
VETMIND_AUTH_ENABLED=0
# VETMIND_API_KEY=
# VETMIND_JWT_SECRET=vetmind-demo-secret-change-me
# VETMIND_JWT_TTL_SECONDS=43200

# Deployment: demo | protected (protected requires auth + strong JWT secret)
VETMIND_DEPLOYMENT_MODE=demo
# VETMIND_TENANT_ISOLATION=1
# VETMIND_ALLOW_INSECURE_DEMO=0
# VETMIND_MALWARE_SCAN_REQUIRED=0
# Encryption: only "none" is implemented — other values refuse startup
VETMIND_ENCRYPTION_AT_REST=none

# Optional audit / feedback paths (auto-set in protected / durable storage)
# VETMIND_AUDIT_LOG_PATH=./data/audit/security.jsonl
# VETMIND_FEEDBACK_LOG_PATH=./data/feedback/feedback.jsonl
# VETMIND_MAX_CONCURRENT_ANALYZE=8
# VETMIND_DEMO_SEED=0

# Retention (dry-run via GET /api/v1/admin/retention/plan; apply requires POST + admin)
# VETMIND_RETENTION_DICOM_DAYS=90
# VETMIND_RETENTION_REPORTS_DAYS=365
# VETMIND_RETENTION_ARTIFACTS_DAYS=180
# VETMIND_RETENTION_TEMP_HOURS=24
# VETMIND_RETENTION_LOGS_DAYS=90

# Optional document OCR HTTP stub (fixtures/integration/document_ocr_*.example.json)
# VETMIND_DOCUMENT_OCR_ENDPOINT=http://127.0.0.1:8091/ocr
# VETMIND_DOCUMENT_OCR_TIMEOUT_S=30
