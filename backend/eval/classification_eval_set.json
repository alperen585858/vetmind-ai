{
  "version": 1,
  "name": "VetMind DICOM classification seed set",
  "note": "Sentetik metadata vakaları. Etiketler kural sınıflandırıcı + ders metrik iskeleti için yazıldı; uzman klinik doğrulaması yok. Klinik validasyon iddiası taşımaz. VRM/uzman verisi gelince genişletilir.",
  "cases": [
    {
      "id": "brain-mri-canine",
      "title": "Net Brain MRI + canine",
      "study": {
        "study_description": "Canine Brain MRI",
        "series": [
          {
            "modality": "MR",
            "series_description": "T1 AX BRAIN",
            "body_part_examined": "BRAIN"
          }
        ]
      },
      "expected": {
        "modality": "MR",
        "region": "BRAIN",
        "species": "canine"
      }
    },
    {
      "id": "cervical-mri",
      "title": "Net Cervical MRI",
      "study": {
        "study_description": "Cervical spine MRI",
        "series": [
          {
            "modality": "MR",
            "series_description": "SAG C SPINE T2",
            "body_part_examined": "CERVICAL"
          }
        ]
      },
      "expected": {
        "modality": "MR",
        "region": "CERVICAL",
        "species": null
      }
    },
    {
      "id": "brain-ct",
      "title": "Net Brain CT",
      "study": {
        "study_description": "Head CT",
