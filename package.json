{
  "name": "vetmind-ai-prototip",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backend:dev": "node scripts/backend.mjs dev",
    "backend:dev:ai": "node scripts/backend.mjs ai",
    "backend:dev:vision": "node scripts/backend.mjs vision",
    "backend:test": "node scripts/backend.mjs test",
    "e2e": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 playwright test",
    "e2e:ui": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 playwright test --ui",
    "build:share": "tsc --noEmit && vite build --mode share --outDir dist-share && node scripts/build-share.mjs"
  },
  "dependencies": {
    "dicom-parser": "^1.8.21",
    "lucide-react": "0.441.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "recharts": "2.12.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.2",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.2",
    "vite": "5.4.8",
    "vitest": "^2.1.4"
  }
}
