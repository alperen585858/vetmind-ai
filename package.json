{
  "name": "vetmind-ai-prototip",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --open",
    "build": "tsc --noEmit && vite build",
    "check:bundle": "node scripts/check-bundle.mjs dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "backend:dev": "node scripts/backend.mjs dev",
    "backend:dev:ai": "node scripts/backend.mjs ai",
    "backend:dev:vision": "node scripts/backend.mjs vision",
    "backend:test": "node scripts/backend.mjs test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "build:share": "tsc --noEmit && vite build --mode share --outDir dist-share && node scripts/build-share.mjs"
  },
  "dependencies": {
    "dicom-parser": "^1.8.21",
    "lucide-react": "0.441.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.7",
    "recharts": "2.12.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "18.3.11",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "10.16.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "postcss": "8.5.34",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.2",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "^5.1.2"
  }
}
